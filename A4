a = int(input('Введите первое число от 1 до 1000: '))
b = int(input('Введите второе число от 1 до 1000: '))
if a > 1000 or b > 1000:
    print('Введено слишком большое значение.')
elif a < 1 or b < 1:
    print('Введео слишком маленькое значение.')
elif a == b:
    print('Значения равны.')
else:
    result = [a, b] [a <= b]
    print('Большее число равно ', result) 