a = int(input('Введите данные счетчика за прошлый месяц: '))
b = int(input('Введите данные счетчика за текущий месяц: '))
c = b - a
if b < a:
    c = 10000 - (a - b)
if c > 800:
    p = 21 + 300 * 0.06 + 200 * 0.04 + (c - 200 - 300 - 300) * 0.025
elif c > 600:
    p = 21 + 300 * 0.06 + (c - 300 - 300) * 0.04
elif c > 300:
    p = 21 + (c - 300) * 0.06
elif c < 300:
    p = 21
z = p / c
print('Предедущее     Текущее     Использовано     К оплате     Ср. цена м^3')
print('   ',a,'        ',b,'         ',c,'         ',f"{p:.2f}",'        ',f"{z:.2f}")